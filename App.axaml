<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="QueryOptimizer.App"
             RequestedThemeVariant="Light">

    <Application.Styles>
        <FluentTheme />
        <Style Selector="Button">
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="13,9" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Button.secondary">
            <Setter Property="Background" Value="#F8FAFD" />
            <Setter Property="Foreground" Value="#42536B" />
            <Setter Property="BorderBrush" Value="#DCE4EF" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.secondary:pointerover">
            <Setter Property="Background" Value="#EAF1FC" />
            <Setter Property="BorderBrush" Value="#C9D8EE" />
        </Style>
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="#2563EB" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="15,9" />
        </Style>
        <Style Selector="Button.primary:pointerover">
            <Setter Property="Background" Value="#1D4ED8" />
        </Style>
        <Style Selector="GridSplitter.paneSplitter:pointerover">
            <Setter Property="Background" Value="#EAF1FC" />
        </Style>
    </Application.Styles>
</Application>
