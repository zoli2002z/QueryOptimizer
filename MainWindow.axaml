<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1120"
        d:DesignHeight="720"
        x:Class="QueryOptimizer.MainWindow"
        Title="Query Optimizer"
        Width="1120"
        Height="720"
        WindowState="Maximized"
        MinWidth="800"
        MinHeight="520"
        Background="#F1F4F2">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#153B36" Padding="28,18">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Spacing="4">
                    <TextBlock Text="Query Optimizer"
                               Foreground="#F5F7F4"
                               FontSize="21"
                               FontWeight="SemiBold" />
                    <TextBlock Text="SQL WORKSPACE"
                               Foreground="#A9C5BD"
                               FontSize="11"
                               FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="1.1*,0.9*" Margin="20">
                <Border Grid.Column="0"
                    Margin="0,0,8,0"
                    Background="#FFFFFF"
                    BorderBrush="#D5DDD8"
                    BorderThickness="1"
                    CornerRadius="5"
                    DragDrop.AllowDrop="True"
                    DragDrop.DragOver="InputQuery_DragOver"
                    DragDrop.Drop="InputQuery_Drop">
                <Grid RowDefinitions="Auto,*">
                    <Grid ColumnDefinitions="*,Auto" Margin="18,14">
                        <StackPanel Spacing="3">
                            <TextBlock Text="Input query"
                                       Foreground="#183C36"
                                       FontSize="15"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="Edit, paste, or drop a .sql file"
                                       Foreground="#687771"
                                       FontSize="12" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Button Content="Select file"
                                    Click="SelectSqlFile_Click"
                                    ToolTip.Tip="Open a .sql file" />
                            <Button Content="Optimize SQL"
                                    IsEnabled="False"
                                    ToolTip.Tip="The optimization engine has not been implemented yet." />
                        </StackPanel>
                    </Grid>
                    <Border Grid.Row="1" BorderBrush="#E1E7E3" BorderThickness="0,1,0,0">
                        <TextBox x:Name="InputQueryEditor"
                                 AcceptsReturn="True"
                                 TextWrapping="NoWrap"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 FontFamily="Cascadia Mono,Consolas,monospace"
                                 FontSize="13"
                                 Padding="18"
                                 BorderThickness="0"
                                 Background="#FFFFFF"
                                 Foreground="#263B35"
                                 PlaceholderText="Place for the SQL select" />
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Margin="8,0,0,0"
                    Background="#FFFFFF"
                    BorderBrush="#D5DDD8"
                    BorderThickness="1"
                    CornerRadius="5">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Margin="18,14" Spacing="3">
                        <TextBlock Text="Optimized query"
                                   Foreground="#183C36"
                                   FontSize="15"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Rewritten SQL will appear here"
                                   Foreground="#687771"
                                   FontSize="12" />
                    </StackPanel>
                    <Border Grid.Row="1"
                            BorderBrush="#E1E7E3"
                            BorderThickness="0,1,0,0"
                            Background="#F8FAF8">
                        <StackPanel HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Spacing="8">
                            <TextBlock Text="No optimized query"
                                       Foreground="#29463F"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="The optimization pipeline will be added here."
                                       Foreground="#687771"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       MaxWidth="280"
                                       TextAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#E5EBE7" Padding="20,10">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock x:Name="StatusText"
                           Text="Ready"
                           Foreground="#40564F"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <TextBlock Grid.Column="1"
                           Text="No database connection"
                           Foreground="#687771"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
