<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1440"
        d:DesignHeight="900"
        x:Class="QueryOptimizer.MainWindow"
        Title="Query Optimizer"
        Icon="avares://QueryOptimizer/icon/query_optimizer_icon.ico"
        Width="1440"
        Height="900"
        WindowState="Maximized"
        MinWidth="900"
        MinHeight="620"
        Background="#F3F6FB">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border Grid.Row="0" Background="#111C2E" Padding="34,22">
            <Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="15" VerticalAlignment="Center">
                    <Border Width="44" Height="44" CornerRadius="13" Background="#246BFE" VerticalAlignment="Center">
                        <TextBlock Text="&lt;_&gt;" Foreground="White" FontSize="16" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="Query Optimizer" Foreground="#F8FAFF" FontSize="21" FontWeight="Bold" />
                        <TextBlock Text="A sharper workspace for better SQL" Foreground="#9EACC2" FontSize="12" />
                    </StackPanel>
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="16" BorderBrush="#33435C" BorderThickness="1"
                        Background="#1B2940" Padding="13,8" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#55D6A7" VerticalAlignment="Center" />
                        <TextBlock Text="LOCAL ANALYSIS" Foreground="#CFD9E8" FontSize="10" FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" RowDefinitions="Auto,*" Margin="32,26,32,24">
            <Grid ColumnDefinitions="*,Auto" Margin="2,0,2,20">
                <StackPanel Spacing="4">
                    <TextBlock Text="SQL workspace" Foreground="#15243A" FontSize="23" FontWeight="Bold" />
                    <TextBlock Text="Refine a query and review practical performance checks." Foreground="#718096" FontSize="13" />
                </StackPanel>
                <Border Grid.Column="1" CornerRadius="8" Background="#E8F0FF" Padding="12,8" VerticalAlignment="Center">
                    <TextBlock Text="SAFE REWRITES ONLY" Foreground="#275BC0" FontSize="10" FontWeight="Bold" />
                </Border>
            </Grid>

            <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="18">
                <Border Grid.Column="0" Background="White" BorderBrush="#DCE4EF" BorderThickness="1"
                        CornerRadius="14" BoxShadow="0 5 20 0 #101B2A0A" DragDrop.AllowDrop="True"
                        DragDrop.DragOver="InputQuery_DragOver" DragDrop.Drop="InputQuery_Drop">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="22,18,18,16">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#EEF4FF">
                                    <TextBlock Text="01" Foreground="#246BFE" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Input query" Foreground="#1B2A40" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Write SQL or drop in a .sql file" Foreground="#8491A4" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="9" VerticalAlignment="Center">
                                <Button Classes="secondary" Padding="10,8" Click="SelectSqlFile_Click"
                                        ToolTip.Tip="Open a .sql file" AutomationProperties.Name="Open SQL file">
                                    <Grid Width="18" Height="18">
                                        <Border Width="14" Height="10" BorderBrush="#53647B" BorderThickness="1.5"
                                                CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                        <Border Width="6" Height="3" BorderBrush="#53647B" BorderThickness="1.5"
                                                CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2,3,0,0" />
                                        <Border Width="1.5" Height="6" Background="#53647B" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Margin="0,1,0,0" />
                                        <Border Width="6" Height="1.5" Background="#53647B" HorizontalAlignment="Center"
                                                VerticalAlignment="Center" Margin="0,1,0,0" />
                                    </Grid>
                                </Button>
                                <Button Classes="primary" Content="Optimize query  →" Click="OptimizeSql_Click" ToolTip.Tip="Apply the available SQL rewrite rules" />
                            </StackPanel>
                        </Grid>
                        <Border Grid.Row="1" Margin="1,0,1,1" CornerRadius="0,0,13,13"
                                BorderBrush="#E7ECF3" BorderThickness="0,1,0,0" Background="#FBFCFE">
                            <Grid RowDefinitions="Auto,*">
                                <Border Padding="18,9" Background="#F5F8FC">
                                    <TextBlock x:Name="InputFileNameText" Text="QUERY.SQL" Foreground="#8996A8" FontSize="10" FontWeight="Bold" />
                                </Border>
                                <TextBox Grid.Row="1" x:Name="InputQueryEditor" AcceptsReturn="True" TextWrapping="NoWrap"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                         FontFamily="Cascadia Mono,Consolas,monospace" FontSize="13" Padding="20"
                                         BorderThickness="0" Background="Transparent" Foreground="#24344C"
                                         PlaceholderText="SELECT customer_id, order_date&#x0a;FROM orders&#x0a;WHERE order_status = 'open';" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="1" Background="White" BorderBrush="#DCE4EF" BorderThickness="1"
                        CornerRadius="14" BoxShadow="0 5 20 0 #101B2A0A">
                    <Grid RowDefinitions="Auto,*">
                        <Grid ColumnDefinitions="*,Auto" Margin="22,18,22,16">
                            <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                                <Border Width="34" Height="34" CornerRadius="10" Background="#EAF8F3">
                                    <TextBlock Text="02" Foreground="#15956A" FontSize="12" FontWeight="Bold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="Optimized result" Foreground="#1B2A40" FontSize="15" FontWeight="SemiBold" />
                                    <TextBlock Text="Review the rewrite and analysis" Foreground="#8491A4" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                <Button x:Name="PreviewToggleBtn" Classes="secondary" Padding="10,8"
                                        Click="PreviewToggle_Click" IsEnabled="False"
                                        ToolTip.Tip="Show line-by-line differences from the input query"
                                        AutomationProperties.Name="Preview SQL changes">
                                    <Grid Width="18" Height="18">
                                        <TextBlock Text="−" Foreground="#A9363E" FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Left" VerticalAlignment="Center" />
                                        <TextBlock Text="+" Foreground="#176B43" FontSize="14" FontWeight="Bold"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                                <Button x:Name="CopyBtn" Classes="secondary" Padding="10,8"
                                        Click="CopyOptimizedSql_Click" IsEnabled="False"
                                        ToolTip.Tip="Copy optimized SQL" AutomationProperties.Name="Copy optimized SQL">
                                    <Grid Width="18" Height="18">
                                        <Border Width="10" Height="12" BorderBrush="#53647B" BorderThickness="1.5"
                                                CornerRadius="2" HorizontalAlignment="Right" VerticalAlignment="Top" />
                                        <Border Width="10" Height="12" BorderBrush="#53647B" BorderThickness="1.5"
                                                CornerRadius="2" Background="#F1F5FA" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                                    </Grid>
                                </Button>
                                <Button x:Name="EditOptimizedSqlBtn" Classes="secondary" Padding="10,8"
                                        Click="EditOptimizedSql_Click" IsEnabled="False"
                                        ToolTip.Tip="Enable editing" AutomationProperties.Name="Enable editing">
                                    <Grid Width="18" Height="18">
                                        <TextBlock Text="✎" Foreground="#53647B" FontSize="16"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border x:Name="ReadOnlyPencilSlash" Width="19" Height="1.5" Background="#A9363E"
                                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsVisible="True">
                                            <Border.RenderTransform>
                                                <RotateTransform Angle="-45" />
                                            </Border.RenderTransform>
                                        </Border>
                                    </Grid>
                                </Button>
                                <Button x:Name="SaveOptimizedSqlBtn" Classes="secondary" Padding="10,8"
                                        Click="SaveOptimizedSql_Click" IsEnabled="False"
                                        ToolTip.Tip="Save optimized SQL" AutomationProperties.Name="Save optimized SQL">
                                    <Grid Width="18" Height="18">
                                        <Border Width="14" Height="15" BorderBrush="#53647B" BorderThickness="1.5"
                                                CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <Border Width="8" Height="5" BorderBrush="#53647B" BorderThickness="1.5"
                                                CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,2,0,0" />
                                        <Border Width="8" Height="4" BorderBrush="#53647B" BorderThickness="1.5"
                                                CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,2" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <Grid Grid.Row="1" RowDefinitions="*,Auto" Margin="1,0,1,1">
                            <Border CornerRadius="0" BorderBrush="#E7ECF3" BorderThickness="0,1,0,0" Background="#FBFCFE">
                                <Grid RowDefinitions="Auto,*">
                                    <Border Padding="18,9" Background="#F5F8FC">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock x:Name="OptimizedFileNameText" Text="OPTIMIZED.SQL" Foreground="#8996A8" FontSize="10" FontWeight="Bold" />
                                            <Border x:Name="UnsavedIndicator" Grid.Column="1" IsVisible="False"
                                                    Background="#FFF4DF" BorderBrush="#F2D49A" BorderThickness="1"
                                                    CornerRadius="10" Padding="8,3">
                                                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <Ellipse Width="6" Height="6" Fill="#D99016" VerticalAlignment="Center" />
                                                    <TextBlock Text="Unsaved" Foreground="#8B5A0A" FontSize="10" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>
                                    <Grid Grid.Row="1">
                                        <TextBox x:Name="OptimizedQueryEditor" IsReadOnly="True" TextChanged="OptimizedQueryEditor_TextChanged" AcceptsReturn="True"
                                                 TextWrapping="NoWrap" ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Auto" FontFamily="Cascadia Mono,Consolas,monospace"
                                                 FontSize="13" Padding="20" BorderThickness="0" Background="Transparent"
                                                 Foreground="#24344C" PlaceholderText="Your optimized query will appear here." />
                                        <Border x:Name="DiffViewBorder" IsVisible="False" Background="#FBFCFE">
                                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                                <StackPanel x:Name="DiffContentPanel" Spacing="5" Margin="16" />
                                            </ScrollViewer>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Background="#F5F8FC" BorderBrush="#E1E8F1" BorderThickness="0,1,0,0"
                                    Padding="18,14" CornerRadius="0,0,13,13">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Border Width="30" Height="30" CornerRadius="9" Background="#E8F0FF" VerticalAlignment="Top">
                                        <TextBlock Text="✦" Foreground="#246BFE" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Spacing="4">
                                        <TextBlock Text="Performance notes" Foreground="#26364D" FontSize="12" FontWeight="SemiBold" />
                                        <ScrollViewer MaxHeight="115" VerticalScrollBarVisibility="Auto">
                                            <TextBlock x:Name="OptimizationFindings" Text="Run an analysis to see query patterns and practical suggestions."
                                                       Foreground="#68778D" FontSize="11" LineHeight="17" TextWrapping="Wrap" />
                                        </ScrollViewer>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="#E9EEF5" BorderBrush="#DCE4EF" BorderThickness="0,1,0,0" Padding="32,11">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="#246BFE" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText" Text="Ready when you are" Foreground="#53647B" FontSize="11" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Static analysis · No database connection" Foreground="#8491A4" FontSize="10" VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
